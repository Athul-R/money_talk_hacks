# ── Supabase (optional — everything runs keyless with the local JSON store) ──
# Backend writes runs/branches/pips/events with the service key; the console
# subscribes with the anon key. Leave blank to run fully local.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── LLM narration (optional — narration falls back to templated text) ────────
# provider: openai | anthropic | gemini
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=

# ── Materiality (engine stop rules; defaults shown) ──────────────────────────
MATERIALITY_MIN_SHARE=0.05
MATERIALITY_MIN_ABS_FRAC=0.01
MATERIALITY_STOP_AT_EXPLAINED=0.80
MATERIALITY_MAX_DEPTH=4
MATERIALITY_TOP_N_CUSTOMERS=3

# ── PRISM (optional — Observe → Improve → Prove. No-op without both.) ────────
# Paste these if you want traces in the hackathon project before tomorrow.
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISMTRACE_AGENT_ID=delta-ledger

# ── Tavily web context (optional — live runs fall back to a cached index) ────
TAVILY_API_KEY=

# ── Console (console/.env.local mirrors these with the VITE_ prefix) ─────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=/api
